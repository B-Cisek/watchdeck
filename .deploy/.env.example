GHCR_OWNER=your-github-user
DOMAIN=watchdeck.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf

# openssl rand -hex 32
APP_SECRET=
DEFAULT_URI=https://watchdeck.example.com
WATCHDECK_PUBLIC_URL=https://watchdeck.example.com
DATABASE_URL="postgresql://watchdeck:PASSWORD@<postgres-host>:5432/watchdeck?serverVersion=18&charset=utf8"
LOCK_DSN="postgresql+advisory://watchdeck:PASSWORD@<postgres-host>:5432/watchdeck"
